# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=nikke_unionraid
POSTGRES_HOST_PORT=5432

# JDBC URL (Spring Boot用。ユーザー名/パスワードは含めず、POSTGRES_USER/POSTGRES_PASSWORD を使用)
# composeでは通常この形式で自動生成されるため変更不要
DATABASE_URL=jdbc:postgresql://localhost:5432/nikke_unionraid

# Default Timezone (hours offset from UTC, default: 9 for JST)
# ユーザー向け表示に使用するタイムゾーンのUTCオフセット（時間単位）。
# 運用想定値は 9（JST = UTC+9）。DBへの保存は常にUTCで行われる。
DEFAULT_TIMEZONE_HOURS=9

# ========================================
# Next.js Web Frontend Configuration
# ========================================

# Spring Boot API のベース URL
# ローカル npm dev 用: http://localhost:8080
# docker-compose の web サービスは http://bot:8080 で自動上書きされます
BACKEND_URL=http://localhost:8080

# Discord OAuth 設定
# Discord Developer Portal (https://discord.com/developers/applications) で取得
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# セッション暗号化キー (本番環境では必ず32文字以上のランダムな文字列に変更)
SESSION_SECRET=complex_password_at_least_32_characters_long