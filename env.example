# Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=nikke_unionraid
POSTGRES_HOST_PORT=5432

# JDBC URL (Spring Boot用。ユーザー名/パスワードは含めず、POSTGRES_USER/POSTGRES_PASSWORD を使用)
# composeでは通常この形式で自動生成されるため変更不要
DATABASE_URL=jdbc:postgresql://localhost:5432/nikke_unionraid

# Default Timezone (hours offset from UTC, default: 9 for JST)
# ユーザー向け表示に使用するタイムゾーンのUTCオフセット（時間単位）。
# 運用想定値は 9（JST = UTC+9）。DBへの保存は常にUTCで行われる。
DEFAULT_TIMEZONE_HOURS=9