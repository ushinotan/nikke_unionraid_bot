# PostgreSQL 接続設定（ホスト側での npm run dev 専用）
#
# 【重要】将来的には Issue #41 で docker-compose に web サービスが追加され、
# docker-compose 経由での実行が推奨される構成になります。
# その際、これらの環境変数は docker-compose.yml から自動的に注入されるため、
# web/.env や web/.env.local ファイルは不要になります。
#
# このファイルは、ホストマシン上で直接 npm run dev を実行する場合の
# 一時的な設定用です。プロジェクトルートの .env と同じ値を使用してください。

# ホスト名
# - ホスト側で npm run dev する場合: localhost
# - docker-compose 経由の場合（#41 以降）: db（自動注入）
POSTGRES_HOST=localhost

# ポート番号
POSTGRES_PORT=5432

# データベース名
POSTGRES_DB=nikke_unionraid

# ユーザー名
POSTGRES_USER=postgres

# パスワード（プロジェクトルートの .env と同じ値）
POSTGRES_PASSWORD=your_secure_password_here
